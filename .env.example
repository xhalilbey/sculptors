# Every environment variable the app reads. Copy to .env.local and fill in;
# never commit values. NODE_ENV and NEXT_RUNTIME are set by Next.js itself.
# The owner's settings are in .env.migrate.example; the app refuses to start
# if they are in its environment.

# The app's public origin (same-origin checks, redirects, WorkOS callback default).
NEXT_PUBLIC_APP_URL=
# Optional landing hero variant; unset uses the default hero.
NEXT_PUBLIC_LANDING_HERO_VARIANT=

# WorkOS server API key.
WORKOS_API_KEY=
# WorkOS client id.
WORKOS_CLIENT_ID=
# At least 32 characters; seals the session cookie.
WORKOS_COOKIE_PASSWORD=
# Optional; defaults to NEXT_PUBLIC_APP_URL + /api/auth/workos/callback.
WORKOS_REDIRECT_URI=
# Verifies WorkOS webhook signatures; unset makes the webhook answer 503.
WORKOS_WEBHOOK_SECRET=

# Comma-separated WorkOS user ids allowed to sign in; empty admits nobody.
SCULPTORS_ALLOWED_WORKOS_USER_IDS=
# Legacy single-user allowlist entry, still honoured.
SCULPTORS_OWNER_WORKOS_USER_ID=

# Neon pooled host (-pooler), user sculptors_app, sslmode=verify-full. The only URL the app reads.
DATABASE_URL=

