{
  "name": "sculptors-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3002",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.migrate.local ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:check": "drizzle-kit check",
    "typecheck": "tsc --noEmit",
    "check:routes": "node scripts/check-route-guards.mjs",
    "verify": "npm run typecheck && npm run lint && npm run check:routes && npm run db:check && npm run test",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@workos-inc/node": "^9.1.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^0.544.0",
    "next": "^16.3.6",
    "pg": "^8.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.68.0",
    "react-hot-toast": "^2.6.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.6",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.10",
    "tailwindcss": "^4",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  }
}
