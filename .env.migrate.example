# Owner-only settings. Copy to .env.migrate.local (never .env.local) and fill
# in; never commit values. Only `npm run db:migrate` loads this file
# (node --env-file). Next.js loads .env.local into the server process, and the
# owner bypasses row level security, so src/db/env.ts refuses to start the app
# while either name below is set in its environment.

# Neon direct host as the owner, sslmode=verify-full; read only by drizzle-kit.
DATABASE_URL_UNPOOLED=
# Optional; Neon management API for provisioning scripts. The app never reads it.
NEON_API_KEY=
